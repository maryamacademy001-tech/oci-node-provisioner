# OCI A1 Flex Provisioner - example environment configuration
#
# Copy this file to ".env" and fill in real values, OR (preferred for CI)
# provide the same names as GitHub Actions Secrets.
#
# NEVER commit a real ".env". This example contains PLACEHOLDERS ONLY.

OCI_USER_ID=ocid1.user.oc1..REPLACE_WITH_YOUR_USER_OCID
OCI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY_AS_SINGLE_LINE_OR_REAL_NEWLINES\n-----END PRIVATE KEY-----
OCI_FINGERPRINT=XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX
OCI_TENANCY_ID=ocid1.tenancy.oc1..REPLACE_WITH_YOUR_TENANCY_OCID
OCI_REGION=REPLACE_WITH_REGION_for_example_me-abudhabi-1

# Optional overrides (leave blank to use tenancy as compartment / discover ADs)
OCI_COMPARTMENT_ID=
OCI_AVAILABILITY_DOMAINS=

OCI_SUBNET_ID=ocid1.subnet.oc1..REPLACE_WITH_YOUR_SUBNET_OCID
OCI_PUBLIC_SSH_KEY=ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_SSH_KEY provisioner@example.com

# Optional sizing knobs (defaults shown)
# OCI_OCPUS=2
# OCI_MEMORY_GB=12
# OCI_BOOT_VOLUME_GB=100
# OCI_MAX_ATTEMPTS=3
# OCI_RETRY_DELAY_SECONDS=45
# OCI_DISPLAY_NAME=erp-a1-flex-2ocpu-12gb
